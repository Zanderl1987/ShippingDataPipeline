# Pipeline settings
SDP_DATA_DIR=./data
SDP_STORAGE_DIR=./storage
SDP_LOG_LEVEL=INFO

# AISStream
AISSTREAM_API_KEY=

# Axiomancer (no auth needed)
# Axiomancer Overwatch is free, no auth. Rate limit: 60 req/min, 1000/day.

# Global Fishing Watch
GFW_API_TOKEN=

# VesselAPI
VESSELAPI_API_KEY=

# ShipLookup
SHIPLOOKUP_API_KEY=

# UN Comtrade
UN_COMTRADE_API_KEY=

# Open-Meteo (no auth needed)

# EIA Petroleum (free API key)
EIA_API_KEY=

# Hormuz Monitor (free tier)
HORMUZ_API_KEY=

# Notifications (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Notification log file
NOTIFICATION_LOG_FILE=./data/notifications.log
